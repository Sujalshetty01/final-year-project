# Environment Configuration for Malware Classification System
# Copy to .env and customize for your environment

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Frontend Configuration
FRONTEND_URL=http://localhost:8080
FRONTEND_PORT=8080
REACT_APP_API_URL=http://localhost:8000/api/v1

# Model Configuration
MODEL_DIR=./models
GNN_MODEL_PATH=./models/gnn_model.pt
BASELINE_MODEL_DIR=./models/baseline

# Maximum upload size (MB)
MAX_UPLOAD_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# API Security
API_KEY_ENABLED=false
API_KEY=your-secret-key-here

# ML Inference Configuration
INFERENCE_TIMEOUT=60
BATCH_SIZE=32
MAX_CACHE_SIZE=1000
CACHE_TTL_SECONDS=3600

# Graph Processing
GRAPH_MAX_NODES=1000
GRAPH_TIMEOUT=30

# PyTorch Configuration
# Set to empty string to use CPU, or specify CUDA device IDs
CUDA_VISIBLE_DEVICES=
PYTORCH_CUDA_ALLOC_CONF=

# Docker Compose
COMPOSE_PROJECT_NAME=malware-classification
COMPOSE_FILE=docker-compose.yml
