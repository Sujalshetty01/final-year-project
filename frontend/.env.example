# Example environment variables for frontend
# For local development (npm start):
REACT_APP_API_URL=http://localhost:8000/api/v1
# For Docker Compose, this is set in docker-compose.yml as:
#   REACT_APP_API_URL=http://backend:8000/api/v1
#
# Do NOT use 'backend' in local .env. Only Docker Compose can resolve 'backend'.
